# ==========================================================
# CURSORADAR - CONFIGURAÇÃO MULTIUSUÁRIO & PLATAFORMA WEB
# ==========================================================

# ----------------------------------------------------------
# 1. FRONTEND WEB (NEXT.JS 15)
# ----------------------------------------------------------
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ----------------------------------------------------------
# 2. SUPABASE & BANCO DE DADOS (POSTGRESQL + AUTH + RLS)
# ----------------------------------------------------------
# URL do projeto Supabase (cloud ou local via Supabase CLI / Docker)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Chave pública anônima (segura para o browser com RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Chave de serviço privada (USO ESTRITO NO WORKER / BACKEND, NUNCA NO BROWSER)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Conexão direta PostgreSQL (usada pelo worker Python ou migrações locais)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cursoradar

# ----------------------------------------------------------
# 3. TELEGRAM BOT (MULTI-USER NOTIFIER & ACCOUNT LINKING)
# ----------------------------------------------------------
# Token do bot gerado pelo @BotFather no Telegram
TELEGRAM_BOT_TOKEN=123456789:ABCDefghIJKlmNoPQRsTUVwxyZ
# Username público do Bot (sem o @) para links diretos t.me/BotUsername?start=TOKEN
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=CursoRadarAlertsBot

# ----------------------------------------------------------
# 4. PROVIDER SENAC SP & SCRAPING
# ----------------------------------------------------------
# Token opcional de autorização do endpoint de bolsa do Senac SP
SENAC_BOLSA_AUTH="seu_token_aqui"
SENAC_BASE_URL=https://www.sp.senac.br

# ----------------------------------------------------------
# 5. CONFIGURAÇÃO DO WORKER (SERVICES/MONITOR)
# ----------------------------------------------------------
# Intervalo de checagem contínua das ofertas rastreadas (em segundos)
CHECK_INTERVAL_SECONDS=60
# Intervalo de envio de heartbeat de integridade do worker (em segundos)
HEARTBEAT_INTERVAL_SECONDS=30
# Nível de log: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
# Limiar de falhas consecutivas antes de registrar incidente
CONSECUTIVE_FAILURES_ALERT_THRESHOLD=3

# ----------------------------------------------------------
# 6. CONFIGURAÇÃO DO DOCKER COMPOSE (LOCAL)
# ----------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=cursoradar
